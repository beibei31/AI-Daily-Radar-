# Supabase read access for the Next.js server-rendered homepage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase write access for the ingestion pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# Generic OpenAI-compatible LLM endpoint. If omitted, the pipeline uses a low-cost heuristic fallback.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional GitHub token to increase repository search rate limits.
GITHUB_TOKEN=

# Optional pipeline tuning.
PIPELINE_MAX_CANDIDATES=60
PIPELINE_MIN_SCORE=55
PIPELINE_RECENCY_HOURS=72
LLM_BATCH_SIZE=10
CURIOSITY_ITEMS_PER_DAY=3

# Optional semicolon- or newline-separated RSS sources: "Name|https://example.com/feed"
# Useful for Juejin/CSDN/personal blogs/RSSHub routes if you have a stable feed.
EXTRA_TECH_RSS_SOURCES=
